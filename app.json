{
  "expo": {
    "name": "Axiom",
    "slug": "axiom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "axiom",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D4A35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.axiom.carbon"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D4A35"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.axiom.carbon"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Axiom uses your location to automatically detect transport emissions."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Axiom uses your camera to analyze food for carbon footprint."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0D4A35"
        }
      ],
      "expo-web-browser"
    ]
  }
}
